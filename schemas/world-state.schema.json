{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Infinite Red World State v1",
  "type": "object",
  "required": ["version", "seed", "badges", "player_level_hint", "current_area", "areas", "promises", "history"],
  "properties": {
    "version": { "const": 1 },
    "seed": { "type": "integer", "minimum": 0 },
    "badges": { "type": "integer", "minimum": 0, "maximum": 8 },
    "player_level_hint": { "type": "integer", "minimum": 1 },
    "current_area": { "type": "string" },
    "starter": { "type": ["string", "null"] },
    "rival_defeated": { "type": "boolean" },
    "areas": { "type": "object", "additionalProperties": { "$ref": "#/$defs/area" } },
    "promises": { "type": "object" },
    "history": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "area": {
      "type": "object",
      "required": ["id", "name", "kind", "challenge", "exits", "npcs"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "enum": ["interior", "settlement", "route", "dungeon"] },
        "challenge": { "type": "number", "minimum": 1 },
        "came_from": { "type": ["string", "null"] },
        "exits": { "type": "array" },
        "npcs": { "type": "array" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
